{
 "subject": "Your sign-in code for Riverside & Co",
 "text": "Your Clearway sign-in code\n\n012345\n\nEnter this code to sign in to Riverside & Co. You can use it on another device.\n\nUse your newest code. It expires in 10 minutes and allows 5 attempts.\n\nOr open this link and tap Confirm sign-in:\nhttps://live.clearway.co/room/e/confirm?challenge=c&token=t\n\nIf you didn’t ask for this code, you can ignore this email.",
 "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Your Clearway sign-in code</title></head>\n<body style=\"margin:0;background:#F9F9FB;font-family:'Plus Jakarta Sans', ui-sans-serif, system-ui, -apple-system, sans-serif;font-size:16px;line-height:1.6;color:#03294E\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:24px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px\"><tr><td style=\"font-family:'Plus Jakarta Sans', ui-sans-serif, system-ui, -apple-system, sans-serif;font-size:16px;line-height:1.6;color:#03294E\">\n<p style=\"margin:0 0 24px;font-weight:700\">Clearway Live</p>\n<h1 style=\"margin:0 0 16px;font-size:24px;line-height:1.2\">Your sign-in code</h1>\n<p style=\"margin:0 0 24px\">Sign in to Riverside &amp; Co.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#03294E;border-radius:12px\"><tr><td align=\"center\" style=\"padding:24px\">\n<p id=\"sign-in-code\" style=\"margin:0;color:#F9F9FB;font-size:48px;font-weight:700;line-height:1.2;letter-spacing:0.1em;white-space:nowrap\">012345</p>\n</td></tr></table>\n<p style=\"margin:24px 0 16px\">Enter this code in the room. You can use it on another device.</p>\n<p style=\"margin:0 0 24px\">Use your newest code. It expires in 10 minutes and allows 5 attempts.</p>\n<p style=\"margin:0 0 16px\">Or sign in on this device:</p>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"background:#3868D4;border-radius:6px\"><a href=\"https://live.clearway.co/room/e/confirm?challenge=c&amp;token=t\" style=\"display:inline-block;padding:16px 24px;color:#F9F9FB;font-weight:600;text-decoration:none\">Confirm sign-in</a></td></tr></table>\n<p style=\"margin:24px 0 0;font-size:14px\">If you didn’t ask for this code, you can ignore this email.</p>\n</td></tr></table></td></tr></table></body></html>"
}
