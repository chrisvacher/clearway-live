{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": true
  },
  "crons": [
    {
      "path": "/api/cron/practice-reset",
      "schedule": "17 9 * * *"
    },
    {
      "path": "/api/cron/check-ins",
      "schedule": "7 13 * * *"
    },
    {
      "path": "/api/cron/operations",
      "schedule": "37 * * * *"
    }
  ]
}
