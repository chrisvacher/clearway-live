# PR 1 builds without credentials. Configure later integrations per environment.
# Secret values belong in Vercel environment settings, never in source control.
# The Supabase URL and publishable key are public configuration, not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, required by later PRs:
SUPABASE_SERVICE_ROLE_KEY=
TEAM_HUB_DATABASE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Google OAuth client ID and secret are configured in Supabase's Google provider.
