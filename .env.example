# Builds without credentials. Set these per deployment environment in Vercel.
# Use a separate Supabase branch or staging project for authenticated previews.
# Production defaults to https://live.clearway.co. Local tests override this.
APP_ORIGIN=https://live.clearway.co
# Server auth uses a public key and each user's session, never the service key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Existing public variable names are also supported as a fallback:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, required by authenticated room and background workflows:
SUPABASE_SERVICE_ROLE_KEY=
TEAM_HUB_DATABASE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# EMAIL_FROM is also accepted and takes precedence over RESEND_FROM_EMAIL.
# AI drafting and live assistance. Model defaults are in lib/ai/config.ts.
ANTHROPIC_API_KEY=
# Optional model overrides, set to model ids approved for this deployment:
CLEARWAY_AI_MODEL_LIVE=
CLEARWAY_AI_MODEL_DEEP=
# Required in Vercel Production for check-ins and nightly practice reset.
# Generate a secret for the deployment. Never commit its value.
CRON_SECRET=
# Configure Google OAuth client ID/secret in Supabase's Google provider only.

# Optional database root certificate PEM from Team Hub’s Supabase Database settings.
TEAM_HUB_DATABASE_CA_CERT=
