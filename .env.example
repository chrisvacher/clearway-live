# Builds without credentials. Set these per deployment environment in Vercel.
# Use a separate Supabase branch or staging project for authenticated previews.
# Production defaults to https://live.clearway.co. Local tests override this.
APP_ORIGIN=https://live.clearway.co
# Server auth uses a public key and each user's session, never the service key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Existing public variable names are also supported as a fallback:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, required by later PRs:
SUPABASE_SERVICE_ROLE_KEY=
TEAM_HUB_DATABASE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Configure Google OAuth client ID/secret in Supabase's Google provider only.
