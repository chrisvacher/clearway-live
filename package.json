{
  "name": "clearway-live",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:smoke": "node --import tsx --test tests/smoke/*.test.ts",
    "home:shots": "node --import tsx scripts/refresh-home-shots.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:smoke",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset --local --no-seed",
    "db:lint": "supabase db lint --local --schema public,private --fail-on warning",
    "test:db": "supabase test db --local",
    "check:db": "npm run db:lint && npm run test:db",
    "test:auth": "node --import tsx tests/integration/room-auth.ts",
    "test:team-hub": "node --conditions=react-server --import tsx tests/integration/team-hub-reader.ts",
    "db:seed": "node --import tsx scripts/seed-local.ts",
    "test:practice": "node --import tsx tests/integration/practice-room.ts",
    "test:live": "node --import tsx tests/integration/live-room.ts",
    "test:tv": "node --import tsx tests/integration/tv-pairing.ts",
    "test:controls": "node --import tsx tests/integration/live-controls.ts",
    "test:ai-claim-race": "node --import tsx tests/integration/ai-claim-race.ts",
    "test:submit-lock": "node --import tsx tests/integration/submit-lock.ts",
    "test:browser": "node --import tsx tests/browser/failures.ts",
    "test:load": "node --import tsx tests/browser/load.ts",
    "test:content": "node --import tsx tests/browser/content.ts",
    "test:bars": "node --import tsx tests/browser/bars.ts",
    "test:grid-form-sign": "node --import tsx tests/browser/grid-form-sign.ts",
    "test:handover-intent": "node --import tsx tests/browser/handover-intent.ts",
    "test:map-templates": "node --import tsx tests/browser/map-templates.ts",
    "test:qa": "node --import tsx tests/browser/qa.ts",
    "test:outcomes": "node --import tsx tests/browser/outcomes.ts",
    "test:self-paced": "node --import tsx tests/browser/self-paced.ts",
    "test:templates": "node --import tsx tests/browser/templates.ts",
    "test:ai": "node --import tsx tests/browser/ai-live.ts",
    "test:team-workshop": "node --import tsx tests/browser/team-workshop.ts",
    "test:lens-wall": "node --import tsx tests/browser/lens-wall.ts",
    "test:four-lists": "node --import tsx tests/browser/four-lists.ts",
    "test:lens-summary": "node --import tsx tests/browser/lens-summary.ts",
    "test:read-back": "node --import tsx tests/browser/read-back.ts",
    "test:candidates": "node --import tsx tests/browser/candidates.ts",
    "test:scribe": "node --import tsx tests/browser/scribe.ts",
    "test:promoted-quote": "node --import tsx tests/browser/promoted-quote.ts",
    "test:overnight": "node --import tsx tests/browser/overnight.ts",
    "test:acceptance-live": "node --import tsx tests/browser/acceptance-live.ts",
    "test:premortem-goals": "node --import tsx tests/browser/premortem-goals.ts",
    "test:acceptance-m4": "node --import tsx tests/browser/acceptance-m4.ts",
    "test:acceptance-m5": "node --import tsx tests/browser/acceptance-m5.ts",
    "test:wayfinding": "node --import tsx tests/browser/wayfinding-retreat.ts",
    "test:discover": "node --import tsx tests/browser/discover.ts",
    "test:themes": "node --import tsx tests/browser/themes.ts",
    "test:signal": "node --import tsx tests/browser/signal.ts",
    "test:what-we-heard": "node --import tsx tests/browser/what-we-heard.ts",
    "test:acceptance-m6": "node --import tsx tests/browser/acceptance-m6.ts",
    "test:acceptance-m7": "node --import tsx tests/browser/acceptance-m7.ts",
    "test:check-ins": "node --import tsx tests/browser/check-ins.ts",
    "test:report": "node --import tsx tests/browser/report.ts",
    "test:read-only": "node --import tsx tests/browser/read-only.ts",
    "test:visibility-plan": "node --import tsx tests/browser/visibility-plan.ts",
    "load": "node --import tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.50.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "9.15.3",
    "lucide-react": "0.511.0",
    "mammoth": "1.13.0",
    "next": "15.5.28",
    "pg": "8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "20.19.9",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "eslint": "9.30.1",
    "eslint-config-next": "15.5.28",
    "fontkit": "2.0.4",
    "jszip": "3.10.2",
    "playwright": "1.63.0",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
