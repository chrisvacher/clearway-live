{
  "name": "clearway-live",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:smoke": "node --import tsx --test tests/smoke/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:smoke",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset --local --no-seed",
    "db:lint": "supabase db lint --local --schema public,private --fail-on warning",
    "test:db": "supabase test db --local",
    "check:db": "npm run db:lint && npm run test:db"
  },
  "dependencies": {
    "next": "15.3.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "lucide-react": "0.511.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "class-variance-authority": "0.7.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "20.19.9",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "eslint": "9.30.1",
    "eslint-config-next": "15.3.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
